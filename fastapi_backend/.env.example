# ──────────────────────────────────────────────
# EcoPuntos Pamplona — FastAPI Backend
# Copia este archivo a .env y completa los valores
# ──────────────────────────────────────────────

# PostgreSQL — formato: postgresql+psycopg2://user:pass@host:port/db
DATABASE_URL=postgresql+psycopg2://postgres:CAMBIA_ESTO@localhost:5432/ecopuntos

# JWT — genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# Token expiration in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
