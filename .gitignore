# ============================================================
# .gitignore — EcoPuntos Pamplona
# Angular 22 + FastAPI 0.142 + PostgreSQL 15
# ============================================================

# ── Environment & Credentials (NUNCA en Git) ────────────────
.env
.env.*
!.env.example
backend/.env
fastapi_backend/.env

# ── Node.js / Angular ────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/.angular/
frontend/dist/
frontend/.cache/
.npm/

# ── Python / FastAPI / pytest ─────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.virtualenv/
fastapi_backend/.venv/
fastapi_backend/venv/
fastapi_backend/__pycache__/
fastapi_backend/.pytest_cache/
fastapi_backend/htmlcov/
fastapi_backend/.coverage
fastapi_backend/coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Docker ────────────────────────────────────────────────────
# (docker-compose.yml SÍ se sube — solo volúmenes locales se ignoran)
docker-volumes/
pgdata/

# ── OS & IDE ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs & Temporales ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
.system_generated/
scratch/

# ── Angular específico ────────────────────────────────────────
.angular/
.sass-cache/
connect.lock
typings/
